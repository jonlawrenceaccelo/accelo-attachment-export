# Copy this file to .env and fill in your values. Never commit the real .env.

# The subdomain part of your Accelo URL, e.g. for https://jlaw.api.accelo.com
# this is "jlaw".
ACCELO_DEPLOYMENT=your_deployment_prefix_only

# From an Accelo "Service Application" (Configuration > API Applications in
# your Accelo admin). A service application uses the client_credentials
# grant, which is what this script uses -- no per-user login/browser step.
ACCELO_CLIENT_ID=your-client-id
ACCELO_CLIENT_SECRET=your-client-secret

# Optional. Defaults to read(all). Narrow this if your application is
# scoped down, e.g. "read(resources) read(companies) read(jobs) read(contacts)".
ACCELO_SCOPE=write(all)
